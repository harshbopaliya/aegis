# ========== APPLICATION SETTINGS ==========
ASG_APP_NAME=Aegis
ASG_APP_VERSION=1.0.0
ASG_ENVIRONMENT=production
ASG_DEBUG=false

# ========== SERVER SETTINGS ==========
ASG_HOST=0.0.0.0
ASG_PORT=8000
ASG_WORKERS=4
ASG_REQUEST_TIMEOUT=30
ASG_KEEPALIVE_TIMEOUT=65

# ========== CORS & SECURITY ==========
# Comma-separated list of allowed origins
ASG_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
ASG_TRUSTED_HOSTS=yourdomain.com,api.yourdomain.com
ASG_REQUIRE_HTTPS=true
ASG_CORS_MAX_AGE=600

# ========== OPENAI CONFIGURATION (optional, for demo only) ==========
# Get API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-actual-key-here
ASG_OPENAI_MODEL=gpt-4o-mini
ASG_OPENAI_TIMEOUT=60

# ========== PATHS & STORAGE ==========
ASG_LOG_DIR=logs
ASG_DATA_DIR=data
ASG_SQLITE_PATH=data/gateway.db
ASG_BACKUP_DIR=data/backups

# ========== LOGGING ==========
ASG_LOG_LEVEL=INFO
ASG_LOG_FORMAT=json

# ========== SAFETY POLICY SETTINGS ==========
# Set to true to block all DELETE operations on production
ASG_STRICT_BLOCK_DELETE_PRODUCTION=true
# Risk score threshold (0-100) for requiring human approval
ASG_RISK_THRESHOLD_APPROVAL=70
# Sensitive tables requiring extra protection (comma-separated in env)
# ASG_SENSITIVE_TABLES=users,payments,audit_log,production_orders,api_keys,credentials,secrets

# ========== AGENT MANAGEMENT ==========
# Require agents to be registered before accepting actions
ASG_REQUIRE_AGENT_REGISTRATION=true
# Use registered agent roles instead of client-supplied roles
ASG_ENFORCE_AGENT_ROLES_FROM_REGISTRY=true
# Maximum number of registered agents
ASG_MAX_AGENTS=100

# ========== APPROVAL & HUMAN-IN-THE-LOOP ==========
# Timeout (seconds) for human approvals before auto-rejection
ASG_HUMAN_APPROVAL_TIMEOUT_SECONDS=3600
# Require approval for all high-risk actions
ASG_REQUIRE_APPROVAL_ON_HIGH_RISK=true
# Number of approval escalation levels
ASG_APPROVAL_ESCALATION_LEVELS=2

# ========== AUDIT & OBSERVABILITY ==========
# Audit mode: "full" (dev only), "redact" (default), "encrypt" (requires fernet_key)
ASG_AUDIT_PAYLOAD_MODE=redact
# Allow decryption of encrypted audit blobs (only on secure ops workstations)
ASG_AUDIT_DECRYPT_ALLOWED=false
# Audit retention period (days)
ASG_AUDIT_RETENTION_DAYS=365
# Max audit events cached in memory
ASG_MAX_AUDIT_EVENTS_IN_MEMORY=10000

# ========== ENCRYPTION ==========
# IMPORTANT: Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This is a 32-byte key encoded in base64 for payload encryption and backup encryption
ASG_FERNET_KEY=
# Enable encryption for backup files
ASG_ENCRYPT_BACKUP_FILES=true
# Enable database encryption (requires fernet_key and careful key management)
ASG_ENCRYPT_DATABASE=false

# ========== RATE LIMITING ==========
# Enable rate limiting globally
ASG_ENABLE_RATE_LIMITING=true
# General requests per minute (0 = unlimited)
ASG_RATE_LIMIT_REQUESTS_PER_MINUTE=1000
# Action submissions per minute (0 = unlimited)
ASG_RATE_LIMIT_ACTIONS_PER_MINUTE=100

# ========== DATABASE ==========
# SQLAlchemy connection pool size
ASG_DB_POOL_SIZE=5
# Max overflow connections
ASG_DB_MAX_OVERFLOW=10
# Enable SQL echo logging (development only)
ASG_DB_ECHO=false

# ========== BACKUP & RECOVERY ==========
# Enable automatic periodic backups
ASG_ENABLE_AUTO_BACKUP=true
# Auto-backup interval (hours)
ASG_BACKUP_INTERVAL_HOURS=6
# Backup retention (days)
ASG_BACKUP_RETENTION_DAYS=30
# Maximum backup files to keep
ASG_MAX_BACKUP_FILES=120
